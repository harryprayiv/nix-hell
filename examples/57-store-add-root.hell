#!/usr/bin/env nix-hell
-- examples/57-store-add-root.hell
main = do
  let content = Text.encodeUtf8 "# generated by nix-hell\nhello = true;\n"
  a <- Nix.storeAdd "example.nix" content
  path <- Main.orDie a
  Text.putStrLn ("added to store: " <> StorePath.toText path)

  let rootLink = "/tmp/nix-hell-example-root"
  ar <- Nix.addRoot path rootLink
  case ar of
    Either.Left err -> Exit.die ("addRoot failed: " <> err)
    Either.Right msg -> Text.putStrLn ("registered gc root at: " <> rootLink)

  g <- Nix.gcRoots
  roots <- Main.orDie g
  let rootPaths = List.map StorePath.toText roots
  if List.any (Eq.eq (StorePath.toText path)) rootPaths
    then Text.putStrLn "PASS: path appears in gc roots"
    else Text.putStrLn "NOTE: not yet visible (indirect root, expected)"

orDie = Either.either Exit.die IO.pure
