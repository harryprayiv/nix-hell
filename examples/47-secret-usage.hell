#!/usr/bin/env nix-hell
-- examples/47-secret-usage.hell
-- Sops.get returns Either. The secret never appears as a guest value:
-- Secret.setEnv is a capability sink that injects it into a child
-- process environment directly.
main = do
  r <- Sops.get "secrets/example.yaml" "db_password"
  secret <- Main.orDie r
  cfg <- Secret.setEnv "DB_PASSWORD" secret
    (Process.proc "sh" ["-c", "test -n \"$DB_PASSWORD\" && echo secret injected, value not printed"])
  code <- Process.runProcess cfg
  (Exit.exitWith code :: IO ())

orDie = Either.either Exit.die IO.pure
