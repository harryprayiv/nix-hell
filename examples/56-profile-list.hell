#!/usr/bin/env nix-hell
-- examples/56-profile-list.hell
main = do
  r <- Nix.profileList
  paths <- Main.orDie r
  Text.putStrLn ("installed in default profile: " <> Show.show (List.length paths))
  Monad.forM_ paths \p ->
    Text.putStrLn ("  " <> StorePath.toText p)

orDie = Either.either Exit.die IO.pure
